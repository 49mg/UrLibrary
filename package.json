{
  "name": "ur-library",
  "version": "1.0.0",
  "description": "Ur Library (مكتبة اور): discover free books, read, annotate and transform them with AI",
  "main": "./out/main/index.js",
  "author": "Abdalbakee (mg) Dhia",
  "license": "MIT",
  "homepage": "https://github.com/49mg/UrLibrary",
  "repository": {
    "type": "git",
    "url": "https://github.com/49mg/UrLibrary.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "test:packaged": "playwright test -c e2e-packaged/playwright.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@napi-rs/canvas": "^1.1.0",
    "docx": "^9.15.2",
    "electron-updater": "^6.8.11",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tiptap/extension-placeholder": "^3.32.2",
    "@tiptap/markdown": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/react": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "44.10.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "epubjs": "^0.3.93",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "lucide-react": "^1.68.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.8.15"
    }
  }
}
